# Hermes-Live Bridge Environment Configuration
# Copy this file to .env and fill in your values.

# Required: Your Google Gemini API key (with Flash Live access)
GEMINI_API_KEY=your_gemini_api_key_here

# Shared secret for Bridge <-> Agent authentication
# Generate a strong random token for production use
HERMES_TOKEN=change-me-to-a-strong-random-token

# Set to 'true' to enable debug-only endpoints (e.g., /test/inject_gemini_message)
DEBUG=false
